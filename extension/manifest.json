{
  "manifest_version": 3,
  "name": "FG AI Developer",
  "version": "1.0.3",
  "description": "Agente de desenvolvimento com IA conectado ao GitHub, com chat nativo no Lovable, imagens, arquivos, áudio e Supabase opcional.",
  "permissions": ["storage", "tabs", "activeTab", "sidePanel", "scripting"],
  "host_permissions": [
    "https://ypegwpoykntbpburndjf.supabase.co/*",
    "https://lovable.dev/*"
  ],
  "action": {
    "default_title": "FG AI"
  },
  "background": {
    "service_worker": "background-entry.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*"],
      "js": ["content-lovable.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}