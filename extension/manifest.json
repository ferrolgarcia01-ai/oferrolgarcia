{
  "manifest_version": 3,
  "name": "Ferrol AI Developer",
  "version": "0.2.0",
  "description": "Agente de desenvolvimento conectado ao GitHub com preview opcional no Lovable/Vercel.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://ypegwpoykntbpburndjf.supabase.co/*"
  ],
  "action": {
    "default_title": "Ferrol AI Developer",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
